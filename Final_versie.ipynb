   "metadata": {},
   "outputs": [],
   "source": [
    "def analyseer_instroom(df, startjaar):\n",
    "    # Vaste ondergrens van 2015 voor historische data\n",
    "    min_jaar = 2015\n",
    "    instroom = df[(df['instroom'] == 1) & (df['Studiejaar'] >= min_jaar)].groupby('Studiejaar').size()\n",
    "\n",
    "    # Correctie factoren\n",
    "    correctie = {2020: 1/1.01, 2021: 1/0.99}\n",
    "    instroom_corr = instroom.copy()\n",
    "    for jaar, factor in correctie.items():\n",
    "        if jaar in instroom_corr:\n",
    "            instroom_corr.loc[jaar] *= factor\n",
    "\n",
    "    # Voorspellingen maken vanaf het opgegeven startjaar\n",
    "    X = instroom_corr.index.values.reshape(-1, 1)  \n",
    "    y = instroom_corr.values\n",
    "    \n",
    "    # Regressievoorspelling\n",
    "    reg_model = LinearRegression().fit(X, y)\n",
    "    toekomst = np.arange(startjaar, startjaar + 5).reshape(-1, 1)\n",
    "    reg_pred = reg_model.predict(toekomst)\n",
    "\n",
    "    # SES-voorspelling - AANGEPAST\n",
    "    # Gebruik alleen data tot aan het startjaar (exclusief)\n",
    "    historische_data = instroom_corr[instroom_corr.index < startjaar]\n",
    "    \n",
    "    # Optimaliseer de alpha parameter\n",
    "    \n",
    "    # Maak het uiteindelijke model met de beste alpha\n",
    "    ses_model = ExponentialSmoothing(historische_data, trend='add', damped=True).fit(optimized=True)\n",
    "    #ses_model = ExponentialSmoothing(historische_data, trend='add').fit(smoothing_level=0.6)\n",
    "    ses_pred = ses_model.forecast(5)  # 5 jaar vooruit\n",
    "\n",
    "    # Visualisatie\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    plt.plot(instroom_corr.index, instroom_corr, 'o-', label='Historisch (gecorrigeerd)')\n",
    "    plt.plot(toekomst.flatten(), reg_pred, 's--', label=f'Regressie voorspelling vanaf {startjaar}')\n",
    "    plt.plot(toekomst.flatten(), ses_pred, 'd--', label=f'SES voorspelling (α={0.5:.2f}) vanaf {startjaar}')\n",
    "    plt.title(f'Instroomvoorspelling (data vanaf 2015)\\nVoorspelling vanaf {startjaar}')\n",
    "    plt.legend()\n",
    "    plt.grid(True)\n",
    "    plt.xlabel('Studiejaar')\n",
    "    plt.ylabel('Aantal studenten')\n",
    "    plt.xticks(np.arange(min_jaar, startjaar + 6, 1))\n",
    "    plt.show()\n",
    "\n",
    "    return reg_pred, ses_pred, instroom_corr, toekomst.flatten()\n"
   ]
  },
