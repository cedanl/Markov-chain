    "# Initialiseer opslag\n",
    "alle_resultaten = []\n",
    "\n",
    "# Loop door alle startjaren\n",
    "for startjaar in [2021, 2022, 2023, 2024,2025]:\n",
    "    print(f\"\\n▶ Start projectiejaar: {startjaar}\")\n",
    "\n",
    "    # Instroom en kansmodellen per jaar\n",
    "    reg_pred, ses_pred, instroom_hist, toekomstige_jaren = analyseer_instroom(df, startjaar)\n",
    "    jaar_matrices = bouw_jaar_matrices(df)\n",
    "    reg_kans, ses_kans, jaren, _ = voorspel_kansen(jaar_matrices)\n",
    "    #kans_tussenjaar, kans_terug = bereken_tussenjaar_kansen(df)\n",
    "\n",
    "    # Bouw overgangsmatrices\n",
    "    matrix_stationair = bouw_historische_matrix(df)\n",
    "    matrix_regressie = bouw_matrix(reg_kans)\n",
    "    matrix_ses = bouw_matrix(ses_kans)\n",
    "\n",
    "    matrices_config = {\n",
    "        'stationair': matrix_stationair,\n",
    "        'regressie': matrix_regressie,\n",
    "        'ses': matrix_ses\n",
    "    }\n",
    "\n",
    "    # Simuleer combinaties\n",
    "    projecties = []\n",
    "    for matrix_naam, matrix in matrices_config.items():\n",
    "        for instroom_naam, instroom in [('reg', reg_pred), ('ses', ses_pred)]:\n",
    "            projectie = simuleer_projectie(\n",
    "                pivot_df=pivot_df,\n",
    "                matrices=matrix,\n",
    "                instroom_reeks=instroom,\n",
    "                model_naam=f\"instroom_{instroom_naam}\",\n",
    "                overgang_naam=f\"matrix_{matrix_naam}\",\n",
    "                startjaar=startjaar,\n",
    "                jaren_vooruit=1\n",
    "            )\n",
    "            projecties.append(projectie)\n",
    "\n",
    "    # Combineer projecties van alle combinaties voor dit jaar\n",
    "    jaar_resultaat = pd.concat(projecties, ignore_index=True)\n",
    "    alle_resultaten.append(jaar_resultaat)\n",
    "\n",
    "    # Selecteer instroomkolommen\n",
    "    jaar1_cols = [col for col in jaar_resultaat.columns if col.endswith('_jaar_1_new')]\n",
    "    herstart_cols = [col for col in jaar_resultaat.columns if '_herstart_na_tussenjaar' in col]\n",
    "\n",
    "    # Samenvatting instroom per model\n",
    "    samenvatting = jaar_resultaat.groupby(['model_instroom', 'model_overgang'])[\n",
    "        jaar1_cols + herstart_cols\n",
    "    ].sum().round(1)\n",
    "\n",
    "    print(\"\\n📊 Instroomsamenvatting per model:\")\n",
    "    print(samenvatting)\n",
    "\n",
    "# Combineer alles over alle jaren\n",
    "eindresultaat = pd.concat(alle_resultaten, ignore_index=True)\n",
    "\n",
    "# Optioneel opslaan\n",
    "# eindresultaat.to_csv('studentenprognose_resultaten.csv', index=False)\n",
    "# print(\"\\n✅ Alle resultaten opgeslagen in 'studentenprognose_resultaten.csv'\")\n",
    "\n",
    "# Optioneel: bekijk kolommen\n",
    "print(\"\\n✅ Eindresultaat bevat kolommen:\", eindresultaat.columns.tolist())\n",
    "\n"
   ]
