    "# 4.4 Bouw voorspelde overgangsmatrices\n",
    "def bouw_matrix(overgangen):\n",
    "    matrix = pd.DataFrame(0.0, index=toestanden, columns=toestanden)\n",
    "    for (i, j), p in overgangen.items():\n",
    "        matrix.loc[i, j] = p\n",
    "    #for status, p in kans_tussenjaar.items():\n",
    "       # matrix.loc[status, 'tussenjaar'] = p\n",
    "    matrix['uitstroom'] = matrix.apply(lambda r: max(0.0, 1 - r.drop('uitstroom').sum()), axis=1)\n",
    "    return matrix.div(matrix.sum(axis=1), axis=0).fillna(0)\n"
   ]
