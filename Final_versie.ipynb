    " #3. Historische overgangsmatrix\n",
    "def bouw_historische_matrix(df):\n",
    "    overgang = df.groupby(['huidige_status', 'volgende_status']).size().unstack(fill_value=0)\n",
    "    overgang = overgang.reindex(index=toestanden, columns=toestanden, fill_value=0)\n",
    "    return overgang.div(overgang.sum(axis=1), axis=0).fillna(0)\n"
   ]
  },
