    "# 4.1 Jaar-matrices\n",
    "def bouw_jaar_matrices(df):\n",
    "    matrices = {}\n",
    "    for jaar in range(2018, 2024):\n",
    "        jaar_df = df[df['Studiejaar'] == jaar]\n",
    "        mat = pd.crosstab(jaar_df['huidige_status'], jaar_df['volgende_status'], normalize='index')\n",
    "        matrices[jaar] = mat.reindex(index=toestanden, columns=toestanden, fill_value=0)\n",
    "    return matrices\n"
   ]
  },
  {
