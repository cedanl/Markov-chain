   "metadata": {},
   "outputs": [],
   "source": [
    "def voorspel_kansen(matrices):\n",
    "    weegfactoren = {2020: 1/1.01, 2021: 1/0.99}\n",
    "    jaren = [jaar for jaar in sorted(matrices.keys()) if 2019 <= jaar <= 2024]\n",
    "    reg, ses = {}, {}\n",
    "    geldige_overgangen = [(i, j) for i in toestanden for j in toestanden if i != 'uitstroom']\n",
    "\n",
    "    for (src, dst) in geldige_overgangen:\n",
    "        y = np.array([matrices[jaar].loc[src, dst] * weegfactoren.get(jaar, 1) for jaar in jaren])\n",
    "\n",
    "        if len(y) >= 3 and y.sum() > 0.01:\n",
    "            # Lineaire regressie\n",
    "            X = np.arange(len(y)).reshape(-1, 1)\n",
    "            try:\n",
    "                reg[src, dst] = LinearRegression().fit(X, y).predict([[len(y)]])[0]\n",
    "            except:\n",
    "                reg[src, dst] = 0\n",
    "\n",
    "            # Exponential Smoothing met automatische modelkeuze\n",
    "            try:\n",
    "                if np.all(y > 0):\n",
    "                    model = ExponentialSmoothing(y, trend='mul').fit(smoothing_level=0.1)\n",
    "                else:\n",
    "                    model = ExponentialSmoothing(y, trend='add').fit(smoothing_level=0.1)\n",
    "                ses[src, dst] = model.forecast(1)[0]\n",
    "            except:\n",
    "                ses[src, dst] = 0\n",
    "        else:\n",
    "            reg[src, dst], ses[src, dst] = 0, 0\n",
    "\n",
    "    return reg, ses, jaren, matrices\n",
    "\n",
    "    return reg, ses, jaren, matrices"
   ]
  },
