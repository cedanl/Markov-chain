    "\n",
    "def simuleer_projectie(pivot_df, matrices, instroom_reeks, model_naam, overgang_naam, startjaar, jaren_vooruit=5):\n",
    "    instroom_reeks = np.asarray(instroom_reeks)\n",
    "    resultaten = []\n",
    "    huidige = pivot_df.set_index('Studiejaar').loc[startjaar].reindex(toestanden).fillna(0)\n",
    "\n",
    "    # Definieer instroomstatussen\n",
    "    instroom_statussen =  [s for s in instroom_status ]\n",
    "    \n",
    "    # Totaal instroom in startjaar\n",
    "    totaal_instroom = huidige[instroom_statussen].sum()\n",
    "\n",
    "    # Verdeling op basis van verhouding jaar_1_new vs herstart\n",
    "    totaal_jaar1 = huidige[[s for s in instroom_statussen if s.endswith('_jaar_1_nieuw')]].sum()\n",
    "    verdeling_jaar_1 = totaal_jaar1 / totaal_instroom if totaal_instroom > 0 else 0.5\n",
    "    verdeling_herstart = 1 - verdeling_jaar_1\n",
    "\n",
    "    # Doorstroomstatussen = alles met jaar_1 t/m jaar_>4 ZONDER _new\n",
    "    #doorstroom_statussen = [s for s in toestanden if '_jaar_' in s and not s.endswith('_new')]\n",
    "    doorstroom_statussen = [s for s in doorstroom_status ]\n",
    "\n",
    "    for i in range(jaren_vooruit):\n",
    "        jaar = startjaar + i + 1\n",
    "        instroom = instroom_reeks[i] if i < len(instroom_reeks) else instroom_reeks[-1]\n",
    "\n",
    "        # Selecteer de juiste matrix\n",
    "        if isinstance(matrices, dict):\n",
    "            matrix = matrices.get(jaar, matrices[max(matrices.keys())])\n",
    "        else:\n",
    "            matrix = matrices\n",
    "\n",
    "        # Overgangstoestanden\n",
    "        volgende = pd.Series(0.0, index=toestanden)\n",
    "        for src in toestanden:\n",
    "            if src == 'uitstroom':\n",
    "                continue\n",
    "            for dst in toestanden:\n",
    "                volgende[dst] += huidige[src] * matrix.loc[src, dst]\n",
    "\n",
    "        # Instroom toevoegen\n",
    "        jaar1_statussen = [s for s in toestanden if s.endswith('_jaar_1_nieuw')]\n",
    "       # herstart_statussen = [s for s in toestanden if '_herstart_na_tussenjaar' in s]\n",
    "\n",
    "        instroom_jaar1 = instroom * verdeling_jaar_1 / len(jaar1_statussen)\n",
    "        \n",
    "\n",
    "        for status in jaar1_statussen:\n",
    "            volgende[status] += instroom_jaar1\n",
    "\n",
    "\n",
    "        # Naar tussenjaar\n",
    "        #naar_tussenjaar = sum(huidige[src] * matrix.loc[src, 'tussenjaar'] for src in doorstroom_statussen)\n",
    "        #volgende['tussenjaar'] = naar_tussenjaar + (huidige['tussenjaar'] * matrix.loc['tussenjaar', 'tussenjaar'])\n",
    "\n",
    "        resultaten.append({\n",
    "            'jaar': jaar,\n",
    "            'model_instroom': model_naam,\n",
    "            'model_overgang': overgang_naam,\n",
    "           # 'naar_tussenjaar': naar_tussenjaar,\n",
    "            **{status: volgende[status] for status in toestanden}\n",
    "        })\n",
    "\n",
    "        huidige = volgende.copy()\n",
    "\n",
    "    df_resultaten = pd.DataFrame(resultaten)\n",
    "\n",
    "    # Aggregaties\n",
    "    df_resultaten['instroom'] = df_resultaten[instroom_statussen].sum(axis=1)\n",
    "    df_resultaten['doorstroom'] = df_resultaten[doorstroom_statussen].sum(axis=1)\n",
    "    df_resultaten['totaal'] = df_resultaten['instroom'] + df_resultaten['doorstroom']\n",
    "    df_resultaten['uitstroom'] = df_resultaten['uitstroom'] \n",
    "\n",
    "    return df_resultaten.round(0)"
   ]
